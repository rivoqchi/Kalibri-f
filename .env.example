# Copy to `.env.local` for local Next.js (never commit real secrets).

# ─── API ──────────────────────────────────────────────────
# SSR / Socket.IO talk to this origin. Browser HTTP uses same-origin `/api` rewrite.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Next.js rewrite target for /api/* → Nest (server-only, not exposed to browser)
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: Socket.IO origin if different from NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_WS_URL=https://api.example.com

# ─── Site / SEO ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image hosts for next/image (CDN / R2 public URL)
# NEXT_PUBLIC_IMAGE_CDN_URL=https://cdn.example.com
# NEXT_PUBLIC_R2_PUBLIC_URL=https://media.example.com

# Telegram bot username (without @) — optional UI / deep links
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot

# ─── Store contact / social (navbar, footer) ──────────────
# NEXT_PUBLIC_STORE_PHONE=+99890 318 0510
# NEXT_PUBLIC_STORE_PHONE_TEL=+998903180510
# NEXT_PUBLIC_STORE_INSTAGRAM_URL=https://www.instagram.com/kalibri_texnika_dokoni/
# NEXT_PUBLIC_STORE_TELEGRAM_URL=https://t.me/KalibriGroupcoMchj
# NEXT_PUBLIC_YANDEX_MAP_EMBED_URL=https://yandex.uz/map-widget/v1/?ll=69.2877%2C41.3656&z=14&l=map&pt=69.2877,41.3656,pm2rdm&lang=uz_UZ
